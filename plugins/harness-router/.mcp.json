{
  "mcpServers": {
    "harness-router": {
      "command": "uvx",
      "args": [
        "--from",
        "harness-router[mcp] @ git+https://github.com/franna-cotta/harness-router.git@main",
        "harness-router-mcp"
      ],
      "env_vars": [
        "AZURE_FOUNDRY_API_KEY",
        "AZURE_OPENAI_API_KEY"
      ],
      "env": {
        "HARNESS_ROUTER_PROVIDER": "azure_foundry",
        "AZURE_ENDPOINT": "https://aivoice-foundry-sweden.services.ai.azure.com",
        "AZURE_DECISION_MODEL": "Decision-1"
      }
    }
  }
}
